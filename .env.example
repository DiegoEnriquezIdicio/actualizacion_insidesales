# Credenciales de NetSuite para el script de cambio de Inside Sales.
# Copia este archivo como .env en esta misma carpeta y llena los valores.
# Son las UNICAS 6 variables que necesita el script.
# NO subir el .env al repositorio.

# Endpoint REST de la cuenta (termina en /services/rest/)
ENDPOINT_NETSUITE=https://11012044.suitetalk.api.netsuite.com/services/rest/

# Realm = ID de la cuenta de NetSuite
REALM_NETSUITE_API_EVONET=11012044

# Integration Record (Setup > Integration > Manage Integrations)
CONSUMER_KEY_NETSUITE_API_EVONET=
CONSUMER_SECRET_NETSUITE_API_EVONET=

# Access Token (Setup > Users/Roles > Access Tokens)
TOKEN_KEY_NETSUITE_API_EVONET=
TOKEN_SECRET_NETSUITE_API_EVONET=
